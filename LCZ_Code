/**************************************Generate a 30 m LCZ Classification Map Using Multi-source Landsat Data**********************************************/
var roi = ee.FeatureCollection("projects/pure-ace-465108-e1/assets/AKSYJBJ");
var style = {'color':'FF0000','width':2,'fillColor':"FF000000"};
Map.addLayer(roi.style(style), null, '');
Map.centerObject(roi, 8);
var date_start = '2023-01-01';
var date_end = '2023-12-31';
function maskL457sr(image) {
  var qaMask = image.select('QA_PIXEL').bitwiseAnd(parseInt('11111', 2)).eq(0);
  var saturationMask = image.select('QA_RADSAT').eq(0);
  
  var opticalBands = image.select('SR_B.').multiply(0.0000275).add(-0.2);
  var thermalBand = image.select('ST_B6').multiply(0.00341802).add(149.0);
  
  return image.addBands(opticalBands, null, true)
              .addBands(thermalBand, null, true)
              .updateMask(qaMask)
              .updateMask(saturationMask);
}
function maskL8sr(image) {
  var qaMask = image.select('QA_PIXEL').bitwiseAnd(parseInt('11111', 2)).eq(0);
  var saturationMask = image.select('QA_RADSAT').eq(0);
  var opticalBands = image.select('SR_B.').multiply(0.0000275).add(-0.2);
  var thermalBands = image.select('ST_B.*').multiply(0.00341802).add(149.0);
  return image.addBands(opticalBands, null, true)
              .addBands(thermalBands, null, true)
              .updateMask(qaMask)
              .updateMask(saturationMask);
}
function addIndex(image) {
  var ndvi = image.normalizedDifference(["SR_B5", "SR_B4"]).rename("NDVI").toFloat();
  var lswi = image.normalizedDifference(["SR_B5", "SR_B6"]).rename("LSWI").toFloat();
  var ndsvi = image.normalizedDifference(["SR_B6", "SR_B4"]).rename("NDSVI").toFloat();
  var ndbi = image.normalizedDifference(['SR_B6','SR_B5']).rename('NDBI').toFloat();
  var mndwi = image.normalizedDifference(['SR_B3','SR_B6']).rename('MNDWI').toFloat();
  
  return image.addBands(ndvi).addBands(lswi).addBands(ndsvi)
              .addBands(ndbi).addBands(mndwi);
}

var landsat5 = ee.ImageCollection("LANDSAT/LT05/C02/T1_L2")
                .filterBounds(roi)
                .filter(ee.Filter.calendarRange(1984, 2011, 'year'))
                .filter(ee.Filter.lte('CLOUD_COVER', 20))
                .map(maskL457sr)
                .select(['SR_B1', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B7'], ['SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B6', 'SR_B7'])
                .map(addIndex);

var landsat7 = ee.ImageCollection("LANDSAT/LE07/C02/T1_L2")
                .filterBounds(roi)
                .filter(ee.Filter.calendarRange(2012, 2012, 'year'))
                .filter(ee.Filter.lte('CLOUD_COVER', 20))
                .map(maskL457sr)
                .select(['SR_B1', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B7'], ['SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B6', 'SR_B7'])
                .map(addIndex);

var landsat8 = ee.ImageCollection("LANDSAT/LC08/C02/T1_L2")
                .filterBounds(roi)
                .filter(ee.Filter.calendarRange(2013, 2024, 'year'))
                .filter(ee.Filter.lte('CLOUD_COVER', 10))
                .map(maskL8sr)
                .select(['SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B6', 'SR_B7'])
                .map(addIndex);
var imgCol = landsat5.merge(landsat7).merge(landsat8).filterDate(date_start, date_end).median().clip(roi);
Map.addLayer(imgCol, {max: 0.3, min: 0, bands: ['SR_B4', 'SR_B3', 'SR_B2']}, 'RGB');
var SRTM = ee.Image("USGS/SRTMGL1_003").clip(roi);
var DEM = SRTM.float(); 
var aspect = ee.Terrain.aspect(DEM); 
var slope = ee.Terrain.slope(DEM).float(); 
var multi_image = imgCol.addBands(DEM).addBands(aspect).addBands(slope);
var exportIndices = function(image, indexName) {
  Export.image.toDrive({
    image: image.select(indexName),
    description: indexName + '_export',
    folder: 'indices_exports',
    scale: 30,
    region: roi
  });
};

exportIndices(multi_image, 'NDVI');
exportIndices(multi_image, 'LSWI');
exportIndices(multi_image, 'NDSVI');
exportIndices(multi_image, 'NDBI');
exportIndices(multi_image, 'MNDWI')
var trainingPoints = ee.FeatureCollection("projects/pure-ace-465108-e1/assets/AKS");
var sampleBands = multi_image.bandNames(); 
var training = multi_image.select(sampleBands).sampleRegions({
  collection: trainingPoints,
  properties: ['CLASS'],
  scale: 30,
  geometries: true
});
var withRandom = training.randomColumn('random');
var trainingPartition = withRandom.filter(ee.Filter.lt('random', 0.8));
var testingPartition = withRandom.filter(ee.Filter.gte('random', 0.8));
var classifier = ee.Classifier.smileRandomForest(200)
                .train({
                  features: trainingPartition,
                  classProperty: 'CLASS',
                  inputProperties: sampleBands 
                });

var classified = multi_image.classify(classifier);
Map.addLayer(classified, {palette: ['lightgreen', 'darkgreen', 'pink', 'blue', 'red', 'white'], min: 1, max: 17}, '分类结果');

Export.classifier.toAsset({
  classifier: classifier,
  description: 'ZZ_2023_classifier',
  assetId: 'projects/ee-zhangjunyea/assets/ZZ_2023_classifier'
});
Export.image.toDrive({
  image: classified,
  description: 'classified_image_with_dem',
  folder: 'classified_images_with_dem',
  scale: 30,
  region: roi
});
var classifiedTest = multi_image.classify(classifier);
var confusionMatrix = testingPartition.classify(classifier).errorMatrix('CLASS', 'classification');
print('Confusion Matrix:', confusionMatrix);
print('Overall Accuracy:', confusionMatrix.accuracy());
print('Producer Accuracy:', confusionMatrix.producersAccuracy());
print('Consumer Accuracy:', confusionMatrix.consumersAccuracy());
print('Kappa Coefficient:', confusionMatrix.kappa());
var accuracyTable = ee.FeatureCollection([
  ee.Feature(null, {
    'Metric': 'Overall Accuracy',
    'Value': confusionMatrix.accuracy()
  }),
  ee.Feature(null, {
    'Metric': 'Producer Accuracy',
    'Value': confusionMatrix.producersAccuracy()
  }),
  ee.Feature(null, {
    'Metric': 'Consumer Accuracy',
    'Value': confusionMatrix.consumersAccuracy()
  }),
  ee.Feature(null, {
    'Metric': 'Kappa Coefficient',
    'Value': confusionMatrix.kappa()
  })
]);
Export.table.toDrive({
  collection: accuracyTable,
  description: 'accuracy_table',
  folder: 'accuracy_table_exports'
});
